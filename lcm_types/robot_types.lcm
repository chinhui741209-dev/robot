package robot_lcm;

struct BuddyImu {
    int64_t timestamp;
    double orientation[4];
    double angular_velocity[3];
    double linear_acceleration[3];
}

struct MotorState {
    int64_t timestamp;
    double linear[3];
    double angular[3];
}

struct StatePose {
    int64_t timestamp;
    double position[3];
    double orientation[4];
}
